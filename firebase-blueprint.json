{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PulseGatewaySchema",
  "description": "Firestore schema for Pulse Messenger Business Gateway & OTP Dispatching",
  "entities": {
    "businesses": {
      "path": "businesses/{userId}",
      "description": "Registered business developer accounts",
      "properties": {
        "userId": { "type": "string" },
        "organizationName": { "type": "string" },
        "contactEmail": { "type": "string" },
        "createdAt": { "type": "timestamp" },
        "isVerified": { "type": "boolean" }
      },
      "required": ["userId", "organizationName", "createdAt"]
    },
    "api_keys": {
      "path": "api_keys/{keyId}",
      "description": "API keys generated by businesses for dispatching OTPs",
      "properties": {
        "keyId": { "type": "string" },
        "userId": { "type": "string" },
        "appName": { "type": "string" },
        "apiKey": { "type": "string" },
        "createdAt": { "type": "timestamp" },
        "isActive": { "type": "boolean" },
        "totalDispatched": { "type": "number" }
      },
      "required": ["keyId", "userId", "appName", "apiKey", "createdAt", "isActive"]
    },
    "gateway_dispatches": {
      "path": "gateway_dispatches/{dispatchId}",
      "description": "Real-time OTP & message dispatches routed via the gateway",
      "properties": {
        "dispatchId": { "type": "string" },
        "apiKey": { "type": "string" },
        "senderName": { "type": "string" },
        "recipientPhone": { "type": "string" },
        "otpCode": { "type": "string" },
        "body": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "DELIVERED", "FAILED"] },
        "createdAt": { "type": "timestamp" },
        "deliveredAt": { "type": "timestamp" },
        "latencyMs": { "type": "number" }
      },
      "required": ["dispatchId", "apiKey", "senderName", "recipientPhone", "otpCode", "status", "createdAt"]
    }
  }
}
