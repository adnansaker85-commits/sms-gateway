rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /businesses/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /api_keys/{keyId} {
      allow read, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
    }

    match /gateway_dispatches/{dispatchId} {
      allow create: if isAuthenticated() &&
                    request.resource.data.apiKey is string &&
                    request.resource.data.recipientPhone is string &&
                    request.resource.data.otpCode is string &&
                    request.resource.data.senderName is string;
      allow read: if isAuthenticated();
      allow update: if isAuthenticated();
    }
  }
}
